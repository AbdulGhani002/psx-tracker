{
  "name": "psx-tracker",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3010",
    "build": "next build",
    "start": "next start -p 8010 -H 0.0.0.0",
    "lint": "next lint",
